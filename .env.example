# Backend
GITHUB_TOKEN=your_github_personal_access_token_here

# IBM Bob inference API — required for AI analysis features
# Obtain from bob.ibm.com → your instance → API keys (choose type "Inference")
BOB_API_KEY=
# Base URL of the Bob LiteLLM proxy (provided in your hackathon portal)
BOB_API_URL=https://your-instance.bob.ibm.com
# Model name as listed in the proxy (default: ibm/granite-3-3-8b-instruct)
# BOB_MODEL_ID=ibm/granite-3-3-8b-instruct

# Frontend (prefix with VITE_ to expose to browser)
VITE_BACKEND_URL=http://localhost:8000
